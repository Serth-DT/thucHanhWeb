@model IEnumerable<thuchanhWeb.Models.Product>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Danh Sách Sản Phẩm</h2>
<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4">
            <div class="product-card">
                <img src="@product.ImageUrl" alt="@product.Name">
                <h5>@product.Name</h5>
                <p>@product.Description<br>Giá: $@product.Price</p>
                <a href="@Url.Action("Display", "Product", new { id = product.Id })" class="btn btn-primary">Mua Ngay</a>
            </div>
        </div>
    }
</div>
